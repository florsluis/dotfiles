[user]
	name = {{ .gitName }}
	email = {{ .email }}

[credential "https://github.com"]
	helper = 
	helper = !/opt/homebrew/bin/gh auth git-credential
[credential "https://gist.github.com"]
	helper = 
	helper = !/opt/homebrew/bin/gh auth git-credential

# Per-client Git identities
# To add a client identity:
#   1. cp $CHEZMOI_DIR/assets/gitconfig-client.template ~/.gitconfig-{client-name}
#   2. Edit with client email/name
#   3. Add an includeIf block to ~/.gitconfig.local (untracked) per client directory:
#
# [includeIf "gitdir:~/codebase/{client-name}/"]
#     path = ~/.gitconfig-{client-name}

[includeIf "gitdir:~/.local/share/chezmoi/"]
	path = ~/.gitconfig-personal
[include]
	path = ~/.gitconfig.local
[core]
	excludesfile = {{ .chezmoi.homeDir }}/.gitignore_global
